{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "BLT service alerts",
      "folder": "OTUS",
      "interval": "20s",
      "rules": [
        {
          "uid": "blt-api-errors",
          "title": "API · Error Rate > 1%",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "API HTTP 5xx exceeds 1% for {{ $labels.method }} {{ $labels.route }}",
            "description": "Sustained for 1 minute. See docs/monitoring.md for diagnosis and the controlled fault scenario.",
            "__dashboardUid__": "blt-users-overview",
            "__panelId__": "12"
          },
          "labels": {
            "service": "blt-users-api",
            "severity": "warning",
            "homework": "5"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "100 * (sum by (method, route) (rate(blt_http_requests_total{job=\"blt-users-api\",namespace=\"blt\",status_code=~\"5..\"}[1m]))) / clamp_min((sum by (method, route) (rate(blt_http_requests_total{job=\"blt-users-api\",namespace=\"blt\"}[1m]))), 1e-9)",
                "refId": "A",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "editorMode": "code"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C",
                "type": "math",
                "expression": "$A > 1",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "blt-api-latency",
          "title": "API · p95 latency > 300ms",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "API p95 exceeds 300ms for {{ $labels.method }} {{ $labels.route }}",
            "description": "Sustained for 1 minute. See docs/monitoring.md for diagnosis and the controlled fault scenario.",
            "__dashboardUid__": "blt-users-overview",
            "__panelId__": "7"
          },
          "labels": {
            "service": "blt-users-api",
            "severity": "warning",
            "homework": "5"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "(histogram_quantile(0.95, sum by (le, method, route) (rate(blt_http_request_duration_seconds_bucket{job=\"blt-users-api\",namespace=\"blt\"}[1m])))) and on (method, route) ((sum by (method, route) (rate(blt_http_requests_total{job=\"blt-users-api\",namespace=\"blt\"}[1m]))) > 0)",
                "refId": "A",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "editorMode": "code"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C",
                "type": "math",
                "expression": "$A > 0.3",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "blt-ingress-errors",
          "title": "Ingress · Error Rate > 1%",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "Ingress HTTP 5xx exceeds 1%",
            "description": "Sustained for 1 minute. See docs/monitoring.md for diagnosis and the controlled fault scenario.",
            "__dashboardUid__": "blt-users-overview",
            "__panelId__": "17"
          },
          "labels": {
            "service": "blt-users-api",
            "severity": "warning",
            "homework": "5"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "100 * (sum(rate(nginx_ingress_controller_requests{job=\"ingress-nginx\",namespace=\"blt\",service=\"blt-users-api\",status=~\"5..\"}[1m])) or (sum(rate(nginx_ingress_controller_requests{job=\"ingress-nginx\",namespace=\"blt\",service=\"blt-users-api\"}[1m]))) * 0) / clamp_min((sum(rate(nginx_ingress_controller_requests{job=\"ingress-nginx\",namespace=\"blt\",service=\"blt-users-api\"}[1m]))), 1e-9)",
                "refId": "A",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "editorMode": "code"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C",
                "type": "math",
                "expression": "$A > 1",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "blt-ingress-latency",
          "title": "Ingress · p95 latency > 300ms",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "Ingress p95 exceeds 300ms",
            "description": "Sustained for 1 minute. See docs/monitoring.md for diagnosis and the controlled fault scenario.",
            "__dashboardUid__": "blt-users-overview",
            "__panelId__": "14"
          },
          "labels": {
            "service": "blt-users-api",
            "severity": "warning",
            "homework": "5"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "(histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{job=\"ingress-nginx\",namespace=\"blt\",service=\"blt-users-api\"}[1m])))) and on () ((sum(rate(nginx_ingress_controller_requests{job=\"ingress-nginx\",namespace=\"blt\",service=\"blt-users-api\"}[1m]))) > 0)",
                "refId": "A",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "editorMode": "code"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C",
                "type": "math",
                "expression": "$A > 0.3",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        }
      ]
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "local-webhook",
      "receivers": [
        {
          "uid": "blt-local-webhook",
          "type": "webhook",
          "disableResolveMessage": false,
          "settings": {
            "url": "http://alert-receiver:8080/alerts",
            "httpMethod": "POST"
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "local-webhook",
      "group_by": [
        "grafana_folder",
        "alertname"
      ],
      "group_wait": "10s",
      "group_interval": "30s",
      "repeat_interval": "1h"
    }
  ]
}
