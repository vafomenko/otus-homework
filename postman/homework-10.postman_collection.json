                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const guid = () => pm.variables.replaceIn('{{$guid}}');",
                  "const run = guid();",
                  "pm.collectionVariables.set('loginA', 'hw10_a_' + run);",
                  "pm.collectionVariables.set('loginB', 'hw10_b_' + run);",
                  "pm.collectionVariables.set('password', 'Hw10!' + run);",
                  "['deposit1', 'deposit2', 'orderKey', 'declinedKey'].forEach(key => pm.collectionVariables.set(key, guid()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userA', pm.response.json().id);"
                ]
