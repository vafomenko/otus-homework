    {
      "name": "Конкурентный повтор, Kafka и область действия ключа",
      "item": [
        {
          "name": "Проверить баланс и отправить два одновременных POST /orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "arch.homework"
              }
            ],
            "url": "{{baseUrl}}/billing/account"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('За первый заказ списано ровно 2500', () => pm.expect(pm.response.json().balance).to.eql(7500));",
                  "const variables = pm.collectionVariables;",
                  "const orderRequest = {",
                  "  method: 'POST',",
                  "  url: pm.variables.replaceIn('{{baseUrl}}/orders'),",
                  "  header: {",
                  "    'Host': 'arch.homework',",
                  "    'Content-Type': 'application/json',",
                  "    'Authorization': 'Bearer ' + variables.get('tokenA'),",
                  "    'Idempotency-Key': variables.get('declinedKey')",
                  "  },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ price: 20000, sku: 'SKU-1', quantity: 2, slotId: variables.get('slotId') }) }",
                  "};",
                  "const send = () => new Promise((resolve, reject) =>",
                  "  pm.sendRequest(orderRequest, (error, response) => error ? reject(error) : resolve(response)));",
                  "pm.test('Два одновременных POST /orders создали один ресурс', done => {",
                  "  Promise.all([send(), send()]).then(responses => {",
                  "    const id = responses[0].json().id;",
                  "    pm.expect(id).to.be.a('string').and.not.equal(variables.get('paidId'));",
                  "    const flags = responses.map(response => response.headers.get('Idempotency-Replayed'));",
                  "    pm.expect(flags.sort()).to.deep.equal(['false', 'true']);",
                  "    for (const response of responses) {",
                  "      const replayed = response.headers.get('Idempotency-Replayed') === 'true';",
                  "      pm.expect(response.code).to.be.oneOf(replayed ? [200, 202] : [201, 202]);",
                  "      pm.expect(response.headers.get('Location')).to.eql('/orders/' + id);",
                  "      pm.expect(response.json().id).to.eql(id);",
                  "    }",
                  "    variables.set('declinedId', id);",
                  "  }).then(() => done(), done);",
                  "});"
                ]
              }
            }
          ]
        },
