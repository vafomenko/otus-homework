    {
      "name": "Создание заказа и повторные HTTP-запросы",
      "item": [
        {
          "name": "Запомнить остаток SKU-1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "arch.homework"
              }
            ],
            "url": "{{baseUrl}}/warehouse/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json().find(row => row.sku === 'SKU-1');",
                  "pm.test('На складе есть товар для заказа', () => pm.expect(product.available).to.be.at.least(2));",
                  "pm.collectionVariables.set('stockBefore', product.available);"
                ]
              }
            }
          ]
        },
        {
          "name": "Выбрать свободный слот курьера",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "arch.homework"
              }
            ],
            "url": "{{baseUrl}}/delivery/slots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json().filter(slot => slot.available === 1);",
                  "pm.test('Есть свободный курьер', () => pm.expect(slots).not.to.be.empty);",
                  "if (slots.length) {",
                  "  const slot = slots[Math.floor(Math.random() * slots.length)];",
                  "  pm.collectionVariables.set('slotId', slot.id);",
                  "  pm.collectionVariables.set('courierId', slot.courierId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать заказ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Host",
                "value": "arch.homework"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{orderKey}}"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 2500,\n  \"sku\": \"SKU-1\",\n  \"quantity\": 2,\n  \"slotId\": \"{{slotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const order = pm.response.json();",
                  "pm.test('Первый запрос создал ресурс', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 202]);",
                  "  pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('false');",
                  "  pm.expect(order.id).to.match(/^[0-9a-f-]{36}$/i);",
                  "  pm.expect(order.userId).to.eql(pm.collectionVariables.get('userA'));",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/orders/' + order.id);",
                  "});",
                  "pm.collectionVariables.set('paidId', order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Дождаться оплаты заказа",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "arch.homework"
              }
            ],
            "url": "{{baseUrl}}/orders/{{paidId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "if (['processing', 'compensating'].includes(order.status)) {",
                  "  const counter = 'attempts_' + pm.info.requestName;",
                  "  const attempt = Number(pm.variables.get(counter) || 0) + 1;",
                  "  pm.variables.set(counter, attempt);",
                  "  pm.test('Ожидание укладывается в 80 попыток', () => pm.expect(attempt).to.be.below(80));",
                  "  if (attempt < 80) setTimeout(() => pm.execution.setNextRequest(pm.info.requestName), 400);",
                  "} else {",
                  "  pm.test('Заказ завершён и имеет ожидаемый результат', () => {",
                  "    pm.expect(order.id).to.eql(pm.collectionVariables.get('paidId'));",
                  "    pm.expect(order.step).to.eql('done');",
                  "    pm.expect(order.status).to.eql('paid');",
                  "    pm.expect(order.reason).to.eql(null);",
                  "  });",
                  "  pm.collectionVariables.set('paidSnapshot', JSON.stringify(order));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Повторить заказ с переставленными полями JSON",
          "request": {
            "method": "POST",
            "header": [
