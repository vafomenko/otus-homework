{
  "info": {
    "name": "OTUS Homework 8 — Stream Processing / Apache Kafka",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Регистрация и биллинг, успешный и отклонённый заказ, проверка двух писем через Kafka, идемпотентность и авторизация. Суммы в копейках RUB. Polling ограничен 60 повторами. Newman печатает запросы и ответы."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 Register user') {",
          "  const run=pm.variables.replaceIn('{{$guid}}').replace(/-/g,'');",
          "  pm.collectionVariables.set('username','hw8_'+run);",
          "  pm.collectionVariables.set('email','hw8_'+run+'@example.com');",
          "  pm.collectionVariables.set('otherUsername','hw8_b_'+run);",
          "  pm.collectionVariables.set('otherEmail','hw8_b_'+run+'@example.com');",
          "  pm.collectionVariables.set('password','Hw8!'+run);",
          "  ['depositId','withdrawalId','invalidId'].forEach(k=>pm.collectionVariables.set(k,pm.variables.replaceIn('{{$guid}}')));",
          "  pm.collectionVariables.unset('accessToken');",
          "}",
          "function redact(value) {",
          "  if (Array.isArray(value)) return value.map(redact);",
          "  if (value && typeof value==='object') return Object.fromEntries(Object.entries(value).map(([k,v])=>[k,/password|token|authorization|service.key/i.test(k)?'[REDACTED]':redact(v)]));",
          "  return value;",
          "}",
          "console.log('REQUEST',pm.request.method,pm.variables.replaceIn(pm.request.url.toString()));",
          "console.log('REQUEST HEADERS',JSON.stringify(redact(pm.request.headers.toObject())));",
          "if (pm.request.body && pm.request.body.raw) {",
          "  const body=pm.variables.replaceIn(pm.request.body.raw);",
          "  try { console.log('REQUEST BODY',JSON.stringify(redact(JSON.parse(body)))); } catch { console.log('REQUEST BODY',body); }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function redact(value) {",
          "  if (Array.isArray(value)) return value.map(redact);",
          "  if (value && typeof value==='object') return Object.fromEntries(Object.entries(value).map(([k,v])=>[k,/password|token|authorization|service.key/i.test(k)?'[REDACTED]':redact(v)]));",
          "  return value;",
          "}",
          "console.log('RESPONSE',pm.response.code,pm.response.status);",
          "console.log('RESPONSE HEADERS',JSON.stringify(pm.response.headers.toObject()));",
          "try { console.log('RESPONSE BODY',JSON.stringify(redact(pm.response.json()))); }",
          "catch { console.log('RESPONSE BODY',pm.response.text()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Host",
            "value": "arch.homework"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Иван\",\n  \"lastName\": \"Тестовый\",\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
