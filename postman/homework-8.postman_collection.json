    {
      "name": "07 Happy letter (poll Kafka consumer)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "arch.homework"
          }
        ],
        "url": "{{baseUrl}}/notifications?orderId={{paidOrderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "",
              "const messages=pm.response.json();",
              "const counter='poll_' + pm.info.requestName;",
              "const attempt=Number(pm.collectionVariables.get(counter)||0);",
              "if (Array.isArray(messages) && messages.length===0 && attempt<60) {",
              "  pm.collectionVariables.set(counter,attempt+1);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "  setTimeout(() => {}, 300);",
              "} else {",
              "  pm.collectionVariables.unset(counter);",
              "  pm.test('Exactly one paid letter saved', () => {",
              "    pm.expect(messages).to.be.an('array').with.lengthOf(1);",
              "    const m=messages[0];",
              "    pm.expect(m.orderId).to.eql(pm.collectionVariables.get('paidOrderId'));",
              "    pm.expect(m.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
              "    pm.expect(m.email).to.eql(pm.collectionVariables.get('email'));",
              "    pm.expect(m.outcome).to.eql('paid');",
              "    pm.expect(m.subject).to.eql('Письмо счастья');",
              "    pm.expect(m.body).to.include(m.orderId);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
