{
  "info": {
    "_postman_id": "2813d137-acb6-4a4d-8ad7-272ff601cb30",
    "name": "OTUS Homework 7 - Authentication and private profiles",
    "description": "Регистрация → запрет без логина → вход → изменение → чтение → выход и отзыв токена → второй пользователь и запрет чужого профиля. Случайные данные создаются на каждой итерации. Общие скрипты выводят метод, URL, заголовки, тело запроса и ответ в Newman; пароли и bearer-токены маскируются.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01. Регистрация пользователя 1') {",
          "  ['userId1','userId2','token1','token2','freshToken1'].forEach(key => pm.collectionVariables.unset(key));",
          "  for (const n of [1, 2]) {",
          "    const id = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
          "    pm.collectionVariables.set('username' + n, 'hw7_' + n + '_' + id);",
          "    pm.collectionVariables.set('password' + n, 'Secure!' + pm.variables.replaceIn('{{$guid}}'));",
          "    pm.collectionVariables.set('email' + n, 'hw7_' + id + '@example.com');",
          "    pm.collectionVariables.set('firstName' + n, pm.variables.replaceIn('{{$randomFirstName}}'));",
          "    pm.collectionVariables.set('lastName' + n, pm.variables.replaceIn('{{$randomLastName}}'));",
          "    pm.collectionVariables.set('phone' + n, '+79' + String(Math.floor(Math.random() * 1e9)).padStart(9, '0'));",
          "  }",
          "  pm.collectionVariables.set('updatedFirstName', 'Updated_' + pm.variables.replaceIn('{{$randomFirstName}}'));",
          "  pm.collectionVariables.set('updatedLastName', 'Updated_' + pm.variables.replaceIn('{{$randomLastName}}'));",
          "  pm.collectionVariables.set('updatedEmail', pm.variables.replaceIn('{{$guid}}') + '@example.com');",
          "  pm.collectionVariables.set('updatedPhone', '+79' + String(Math.floor(Math.random() * 1e9)).padStart(9, '0'));",
          "}",
          "pm.request.headers.upsert({ key: 'Host', value: 'arch.homework' });",
          "const resolved = value => pm.variables.replaceIn(String(value));",
          "const safeHeaders = {};",
          "pm.request.headers.each(h => { if (!h.disabled) safeHeaders[h.key] = /authorization|cookie/i.test(h.key) ? '[REDACTED]' : resolved(h.value); });",
          "let body = pm.request.body && pm.request.body.raw ? resolved(pm.request.body.raw) : '';",
          "try { body = JSON.parse(body); if (body.password) body.password = '[REDACTED]'; } catch (_) {}",
          "console.log('REQUEST', pm.request.method, resolved(pm.request.url.toString()));",
          "console.log('REQUEST HEADERS', JSON.stringify(safeHeaders));",
          "console.log('REQUEST BODY', typeof body === 'string' ? body : JSON.stringify(body));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let body = pm.response.text();",
          "try { body = JSON.parse(body); if (body.accessToken) body.accessToken = '[REDACTED]'; } catch (_) {}",
          "const headers = {}; pm.response.headers.each(h => { headers[h.key] = /set-cookie/i.test(h.key) ? '[REDACTED]' : h.value; });",
          "console.log('RESPONSE', pm.response.code, pm.response.status);",
          "console.log('RESPONSE HEADERS', JSON.stringify(headers));",
          "console.log('RESPONSE BODY', typeof body === 'string' ? body : JSON.stringify(body));",
          "pm.test('Ответ не кешируется', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
        ]
      }
    }
  ],
