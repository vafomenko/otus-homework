    {
      "name": "01. Регистрация пользователя 1",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username1}}\",\n  \"password\": \"{{password1}}\",\n  \"firstName\": \"{{firstName1}}\",\n  \"lastName\": \"{{lastName1}}\",\n  \"email\": \"{{email1}}\",\n  \"phone\": \"{{phone1}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId1', pm.response.json().id);",
              "pm.test('Создан пользователь 1', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username1')));",
              "pm.test('Профиль не содержит секретов', () => { const b = pm.response.json(); ['password', 'passwordHash', 'accessToken', 'tokenHash'].forEach(k => pm.expect(b).not.to.have.property(k)); });"
            ]
          }
        }
      ],
      "response": []
    },
